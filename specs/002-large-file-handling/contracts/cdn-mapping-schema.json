{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dario.ca/schemas/quartz/cdn-mapping.json",
  "title": "CDN Mapping Cache",
  "description": "Schema for .quartz-cache/cdn-mappings.json - tracks uploaded large files for deduplication and orphan detection",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for migration compatibility",
      "const": "1.0.0"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last cache update"
    },
    "mappings": {
      "type": "array",
      "description": "Array of CDN mappings, one per uploaded file",
      "items": {
        "$ref": "#/definitions/CDNMapping"
      }
    }
  },
  "required": ["version", "lastUpdated", "mappings"],
  "definitions": {
    "CDNMapping": {
      "type": "object",
      "description": "Mapping between a local file and its CDN location",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of file content (hex, 64 chars)"
        },
        "localPath": {
          "type": "string",
          "description": "Relative path from content root (e.g., 'docs/research/paper.pdf')"
        },
        "r2Bucket": {
          "type": "string",
          "enum": [
            "large-files-full",
            "large-files-trusted",
            "large-files-shachu",
            "large-files-public"
          ],
          "description": "Target R2 bucket name"
        },
        "r2Key": {
          "type": "string",
          "description": "Object key in R2 (e.g., 'docs/research/a3f5b8c2-paper.pdf')"
        },
        "cdnUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://cdn-(full|trusted|shachu|public)\\.dario\\.ca/",
          "description": "Full HTTPS CDN URL"
        },
        "uploadTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when file was last uploaded"
        },
        "fileSize": {
          "type": "integer",
          "minimum": 20971520,
          "description": "File size in bytes (must be > 20MB = 20971520 bytes)"
        },
        "contentType": {
          "type": "string",
          "description": "MIME type (e.g., 'application/pdf', 'image/png')"
        },
        "accessLevel": {
          "type": "string",
          "enum": ["full", "trusted", "shachu", "public"],
          "description": "Required authentication level"
        },
        "referencedBy": {
          "type": "array",
          "description": "List of note slugs that reference this file",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "hash",
        "localPath",
        "r2Bucket",
        "r2Key",
        "cdnUrl",
        "uploadTimestamp",
        "fileSize",
        "contentType",
        "accessLevel",
        "referencedBy"
      ]
    }
  }
}
